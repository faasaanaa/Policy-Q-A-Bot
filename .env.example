PORT=3000
HOST=127.0.0.1
# Gemini is primary when configured. Without a key, the deterministic engine is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# xAI's API is usage-billed. Set both only if you explicitly enable the paid fallback.
ENABLE_XAI_FALLBACK=false
XAI_API_KEY=
XAI_MODEL=grok-4.7
