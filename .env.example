PORT=3000
HOST=127.0.0.1
# Gemini is primary when configured. Without a key, the deterministic engine is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Groq Console fallback (gsk_ key). Use a Groq Free Plan account; quotas apply.
# Disable with false. Provider outages or rate limits use deterministic evidence.
ENABLE_GROQ_FALLBACK=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
